{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "unsigned": {
      "withoutCredentials": true,
      "channel": "production",
      "environment": "production",
      "ios": {
        "config": "unsigned.yml"
      },
      "node": "24.14.1"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
